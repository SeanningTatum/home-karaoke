# Template for `.dev.vars` — local secrets consumed by the Wrangler/Vite dev
# runtime (Cloudflare Workers env vars for local dev, NOT `.env`/Vite client
# vars). `.dev.vars*` is gitignored except this example file.
#
# Copy this file to `.dev.vars` and fill in real values before running
# `bun run dev`:
#
#   cp .dev.vars.example .dev.vars

BETTER_AUTH_SECRET=change-me-openssl-rand-hex-16

# YouTube Data API v3 key — used by the group-karaoke search + resolve
# flows (app/services/youtube.ts). Optional: leave unset locally and the
# service degrades gracefully (search fails fast, paste-a-link still works
# via the keyless oEmbed fallback). Get a key from
# https://console.cloud.google.com/apis/credentials (enable "YouTube Data
# API v3"). Production: `bunx wrangler secret put YOUTUBE_API_KEY`.
YOUTUBE_API_KEY=
