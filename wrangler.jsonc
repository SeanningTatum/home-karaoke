// Generated by scripts/first-time-setup.ts — real IDs are filled in by setup; teardown restores dummy values.
{
  "name": "home-karaoke",
  "main": "workers/app.ts",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "build/client",
    "binding": "ASSETS"
  },
  "placement": {
    "mode": "smart"
  },
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "home-karaoke-db",
      "database_id": "21de71e1-09e6-4141-b95f-62872597aacd",
      "migrations_dir": "./drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "home-karaoke-bucket"
    }
  ],
  "workflows": [
    {
      "binding": "EXAMPLE_WORKFLOW",
      "name": "home-karaoke-example-workflow",
      "class_name": "ExampleWorkflow"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "KARAOKE_ROOM",
        "class_name": "KaraokeRoom"
      }
    ]
  },
  // Top-level only — DO migrations apply across all environments for a
  // given worker script and cannot be declared inside `env.preview`.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["KaraokeRoom"]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "workers_dev": true,
  "preview_urls": true,
  "env": {
    "preview": {
      "workers_dev": true,
      "preview_urls": true,
      "d1_databases": [
        {
          "binding": "DATABASE",
          "database_name": "home-karaoke-db-preview",
          "database_id": "401575c8-dea3-4d38-a36c-82684da77433",
          "migrations_dir": "./drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "home-karaoke-bucket-preview"
        }
      ],
      "workflows": [
        {
          "binding": "EXAMPLE_WORKFLOW",
          "name": "home-karaoke-example-workflow-preview",
          "class_name": "ExampleWorkflow"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "KARAOKE_ROOM",
            "class_name": "KaraokeRoom"
          }
        ]
      },
      "ai": {
        "binding": "AI"
      },
      "observability": {
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true,
          "persist": true
        }
      }
    }
  }
}
